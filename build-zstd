#!/bin/bash -e
#
# zstd
# https://github.com/facebook/zstd.git
#
cd "$(dirname "$0")"
set -a; . .env; set +a

pkgname="zstd"
pkgdir="${STOWDIR}/${pkgname}"
srcdir="src/zstd/build/meson"
builddir="${TMPDIR:-/tmp}/build.${pkgname}"

echo "::group::$0"

rm -rf "${builddir}"

meson setup "${builddir}" "${srcdir}" \
  --prefix="${pkgdir}" \
  -Dwrap_mode=nodownload \
  -Dbuildtype=release \
  -Db_lto=true \
  -Db_lto_mode=thin \
  -Dzlib=enabled \
  -Dlzma=enabled \
  -Dlz4=enabled \
  -Dbin_programs=false \
  "$@"

meson compile -C "${builddir}"

rm -rf "${pkgdir}"

meson install -C "${builddir}"
stow -Rd "${STOWDIR}" "${pkgname}"

rm -rf "${builddir}"

echo "::endgroup::"
